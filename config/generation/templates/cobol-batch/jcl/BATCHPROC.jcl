//BATCHJOB JOB (ACCT),'POSTING',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//COMPILE  EXEC IGYWCL,PARM.COBOL='LIB,APOST'
//COBOL.SYSIN DD DISP=SHR,DSN=CLIENT.COBOL(BATCHPROC)
//COBOL.SYSLIB DD DISP=SHR,DSN=CLIENT.COPYLIB
//RUN      EXEC PGM=BATCHPROC,COND=(0,NE)
//STEPLIB  DD DISP=SHR,DSN=CLIENT.LOADLIB
//TRANSACTION-FILE DD DISP=SHR,DSN=CLIENT.INPUT.TRANSACTIONS
//REPORT-FILE DD DISP=(NEW,CATLG,DELETE),DSN=CLIENT.OUTPUT.POSTINGS,
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=91,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
