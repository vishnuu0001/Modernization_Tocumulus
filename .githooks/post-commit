#!/bin/sh

# Automatically publish completed commits from this checkout to the approved
# Modernization_Tocumulus repository. Set MODERNIZATION_SKIP_AUTO_PUSH=1 for a
# deliberately local-only commit.
if [ "${MODERNIZATION_SKIP_AUTO_PUSH:-0}" = "1" ]; then
  echo "Auto-push skipped (MODERNIZATION_SKIP_AUTO_PUSH=1)."
  exit 0
fi

expected_remote="https://github.com/vishnuu0001/Modernization_Tocumulus.git"
actual_remote="$(git config --get remote.origin.url 2>/dev/null || true)"

if [ "$actual_remote" != "$expected_remote" ]; then
  echo "Auto-push blocked: origin is '$actual_remote'; expected '$expected_remote'." >&2
  exit 1
fi

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$branch" ]; then
  echo "Auto-push skipped: HEAD is detached." >&2
  exit 0
fi

echo "Publishing commit $(git rev-parse --short HEAD) to origin/$branch..."
if ! git push origin "HEAD:refs/heads/$branch"; then
  echo "Auto-push failed. The commit remains local; rerun: git push origin $branch" >&2
  exit 1
fi

echo "Auto-push completed: origin/$branch"
