# Required PostgreSQL connection. Use a dedicated database and least-privilege role.
MODERNIZATION_DATABASE_URL=postgresql://modernization:replace-me@127.0.0.1:5432/modernization

# Used only by the one-time database initializer; do not retain this in .env.
MODERNIZATION_BOOTSTRAP_ADMIN_USER=admin

# Public verifier only. Keep credential_signing_private_key.pem offline after issuance.
MODERNIZATION_CREDENTIAL_PUBLIC_KEY=data/security/credential_public_key.pem

# Local code-generation model sized for an RTX 4070 SUPER (12 GB VRAM).
OLLAMA_MODEL=devstral-small-2:24b

# Use two bounded inference lanes on the verified local Ollama host.
# Raise only when the connected inference service has greater verified capacity.
MODERNIZATION_ASYNC_BATCH_WORKERS=2
MODERNIZATION_FILE_WORKERS=2
MODERNIZATION_JAVA_FILE_WORKERS=2
MODERNIZATION_SINGLE_FILE_MEMBER_WORKERS=2
MODERNIZATION_LLM_CACHE_DIR=data/runtime/llm-cache
MODERNIZATION_PLANNING_TOTAL_BUDGET_SECONDS=1800
MODERNIZATION_FILE_GENERATION_MAX_SECONDS=1800
MODERNIZATION_JAVA_FILE_GENERATION_MAX_SECONDS=1800
# File-by-file conversion uses one source-grounded draft; whole-project build
# repair handles cross-file compiler diagnostics after the conversion wave.
MODERNIZATION_CONVERSION_MAX_ATTEMPTS=1
MODERNIZATION_CONVERSION_FILE_MAX_SECONDS=600
MODERNIZATION_JAVA_CONVERSION_FILE_MAX_SECONDS=1200
MODERNIZATION_JOB_WORKERS=1
MODERNIZATION_REPAIR_MAX_ROUNDS=2
MODERNIZATION_REPAIR_TOTAL_BUDGET_SECONDS=900
MODERNIZATION_JAVA_PREBUILD_REPAIR_TOTAL_BUDGET_SECONDS=600
MODERNIZATION_JOB_QUEUE_CAPACITY=4
OLLAMA_MAX_CONCURRENT_REQUESTS=2
OLLAMA_NUM_PARALLEL=2
