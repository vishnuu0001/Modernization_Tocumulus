{$MODERNIZATION_HOSTNAME} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy modernization:18084 {
        flush_interval -1
    }
    log {
        output stdout
        format json
    }
}
