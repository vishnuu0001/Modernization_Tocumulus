# Copy to .env.azure and replace every example value before deployment.
APP_VERSION=1.0.0
MODERNIZATION_IMAGE=YOUR_ACR.azurecr.io/modernization-studio:1.0.0
POSTGRES_IMAGE=postgres:16-bookworm
# Resolve and pin this to an approved immutable digest before a formal demo.
OLLAMA_IMAGE=ollama/ollama:latest
CADDY_IMAGE=caddy:2-alpine
OLLAMA_MODEL=devstral-small-2:24b
MODERNIZATION_HOSTNAME=modernization-poc.example.com
CORS_ORIGINS=https://modernization-poc.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18084
MODERNIZATION_BOOTSTRAP_ADMIN_USER=admin
